{
  "name": "yasready-marketplace",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "Marketplace | YasReady v0.5.0 \u2014 Publishing Handshake with signed one-way imports, shared-account ownership, provenance-preserving sync, launch readiness and explicit author go-live approval.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs",
    "verify": "npm run test && npm run build && node scripts/verify-build.mjs",
    "cloudflare:dev": "wrangler dev src/worker.mjs --local",
    "cloudflare:deploy": "wrangler deploy --config wrangler.jsonc",
    "db:migrate:local": "wrangler d1 migrations apply yasready-marketplace --local",
    "db:migrate:remote": "wrangler d1 migrations apply yasready-marketplace --remote",
    "verify:commerce": "bash COMMERCE_PRO_VERIFY.command",
    "verify:pages": "node scripts/verify-pages.mjs",
    "verify:ingram": "node --test tests/foundation.test.mjs",
    "verify:publishing": "node scripts/verify-publishing.mjs",
    "verify:style": "node scripts/verify-yasready-style.mjs"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "vite": "^7.1.7",
    "wrangler": "^4.40.2"
  }
}
